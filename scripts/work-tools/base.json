      "licenceNote": "Static release builds (Martin Riedl's for Linux and macOS, Gyan Doshi's essentials for Windows), built with GPL parts; run only as separate, unmodified ffmpeg and ffprobe processes, never linked into our code.",
      "homepage": "https://ffmpeg.org/",
      "platforms": {
        "linux-x64": {
          "kind": "archive",
          "files": [
            {
              "url": "https://ffmpeg.martin-riedl.de/download/linux/amd64/1789931100_9.0.2/ffmpeg.zip",
              "sha256": "fa8ecf4abbd290d98f7d188b8649cc6b391ae209a98452be955a15aab1909d7f",
              "size": 33326445
            },
            {
              "url": "https://ffmpeg.martin-riedl.de/download/linux/amd64/1789931100_9.0.2/ffprobe.zip",
              "sha256": "3f428c49070be3d24ec338602b76d412e401ffcb8a5641ef0e729181a232fc32",
              "size": 33223234
            }
          ],
          "bin": "ffmpeg",
          "bins": { "ffprobe": "ffprobe" }
        },
        "darwin-arm64": {
          "kind": "archive",
          "files": [
            {
              "url": "https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2/ffmpeg.zip",
              "sha256": "c8ed4c4e6978a03c485edbfe4e0a5dc2380f8a30bba5150531b31b094492d924",
              "size": 28395699
            },
            {
              "url": "https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2/ffprobe.zip",
              "sha256": "fcbe839537485eaee7a7a8bc5cbc0f90d53617e80943e8a5b2e31cb851197ea6",
              "size": 28317701
            }
          ],
          "bin": "ffmpeg",
          "bins": { "ffprobe": "ffprobe" }
        },
        "darwin-x64": {
          "kind": "archive",
          "files": [
            {
              "url": "https://ffmpeg.martin-riedl.de/download/macos/amd64/1789931006_9.0.2/ffmpeg.zip",
              "sha256": "7c6b4125b191cbf773832dc51f424cf2b6bb7da43007d1e066f95909e47cacd4",
              "size": 33816391
            },
            {
              "url": "https://ffmpeg.martin-riedl.de/download/macos/amd64/1789931006_9.0.2/ffprobe.zip",
              "sha256": "2322438ed2f6319a691291b247d09c69dcaa3a982460d1f269a7e1af335cfdfd",
              "size": 33719233
            }
          ],
          "bin": "ffmpeg",
          "bins": { "ffprobe": "ffprobe" }
        },
        "win32-x64": {
          "kind": "archive",
          "files": [
            {
              "url": "https://github.com/GyanD/codexffmpeg/releases/download/9.0.2/ffmpeg-9.0.2-essentials_build.zip",
              "sha256": "60f467265b1e312373dbcd92200c2618a74850f98d3d078e94296bb3fa2047ba",
              "size": 114768076,
              "strip": 1
            }
          ],
          "bin": "bin/ffmpeg.exe",
          "bins": { "ffprobe": "bin/ffprobe.exe" }
        }
      },
      "probe": {
        "steps": [
          { "run": ["{bin}", "-hide_banner", "-version"], "expect": "^ffmpeg version 9\\.0\\.2" },
          { "run": ["{bin:ffprobe}", "-hide_banner", "-version"], "expect": "^ffprobe version 9\\.0\\.2" },
          { "run": ["{bin}", "-hide_banner", "-loglevel", "error", "-f", "lavfi", "-i", "testsrc=size=64x64:rate=5:duration=1", "-c:v", "libx264", "-y", "{tmp}/probe.mp4"], "expectFile": "{tmp}/probe.mp4", "timeoutMs": 60000 }
        ]
      }
    },
    {
