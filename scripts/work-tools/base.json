{
  "pillar": "toolchain",
  "tools": [
    {
      "name": "libreoffice",
      "version": "26.8.3",
      "licence": "MPL-2.0",
      "licenceNote": "The Document Foundation's official build, unpacked and unmodified; runs only as a separate soffice process. Carlito and Caladea (OFL-1.1) ship inside it.",
      "homepage": "https://www.libreoffice.org/",
      "platforms": {
        "linux-x64": {
          "kind": "debs",
          "files": [
            {
              "url": "https://download.documentfoundation.org/libreoffice/stable/26.8.3/deb/x86_64/LibreOffice_26.8.3_Linux_x86-64_deb.tar.gz",
              "sha256": "e7cd3538e85818ff9dd9bb65386769fde927011242aace5a144989f4000dcabf",
              "size": 221377373
            }
          ],
          "bin": "opt/libreoffice26.8/program/soffice",
          "check": ["opt/libreoffice26.8/share/fonts/truetype/Carlito-Regular.ttf", "opt/libreoffice26.8/share/fonts/truetype/Caladea-Regular.ttf"]
        },
        "darwin-arm64": {
          "kind": "dmg",
          "files": [
            {
              "url": "https://download.documentfoundation.org/libreoffice/stable/26.8.3/mac/aarch64/LibreOffice_26.8.3_MacOS_aarch64.dmg",
              "sha256": "de943203795e5057785f65515063e2db5eb60b0bb6d8e2534fec59e5cc5fb988",
              "size": 299927705
            }
          ],
          "app": "LibreOffice.app",
          "bin": "LibreOffice.app/Contents/MacOS/soffice",
          "check": ["LibreOffice.app/Contents/Resources/fonts/truetype/Carlito-Regular.ttf", "LibreOffice.app/Contents/Resources/fonts/truetype/Caladea-Regular.ttf"]
        },
        "darwin-x64": {
          "kind": "dmg",
          "files": [
            {
              "url": "https://download.documentfoundation.org/libreoffice/stable/26.8.3/mac/x86_64/LibreOffice_26.8.3_MacOS_x86-64.dmg",
              "sha256": "bb3c35d628780510915ad9e759d7ed898094d7985d01b2181bd1d4ecd94fd159",
              "size": 309939485
            }
          ],
          "app": "LibreOffice.app",
          "bin": "LibreOffice.app/Contents/MacOS/soffice",
          "check": ["LibreOffice.app/Contents/Resources/fonts/truetype/Carlito-Regular.ttf", "LibreOffice.app/Contents/Resources/fonts/truetype/Caladea-Regular.ttf"]
        }
      },
      "probe": {
        "write": { "probe.txt": "TempCode toolchain probe" },
        "steps": [
          { "run": ["{bin}", "--version"], "expect": "LibreOffice 26\\.8", "timeoutMs": 120000 },
          {
            "run": ["{bin}", "-env:UserInstallation={tmpUrl}/profile", "--headless", "--norestore", "--convert-to", "pdf", "--outdir", "{tmp}", "{tmp}/probe.txt"],
            "expectFile": "{tmp}/probe.pdf",
            "timeoutMs": 180000
          }
        ]
      }
    },
    {
      "name": "python",
      "version": "3.12.16",
      "licence": "PSF-2.0",
