      "homepage": "https://github.com/astral-sh/python-build-standalone",
      "platforms": {
        "linux-x64": {
          "kind": "archive",
          "files": [
            {
              "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20261110/cpython-3.12.16%2B20261110-x86_64-unknown-linux-gnu-install_only.tar.gz",
              "sha256": "c2f87d4b4e8db3abddb0f116c6ccfc503d0cbdbb9ee8faacddad1b679ec12e99",
              "size": 68163679
            }
          ],
          "bin": "python/bin/python3"
        },
        "darwin-arm64": {
          "kind": "archive",
          "files": [
            {
              "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20261110/cpython-3.12.16%2B20261110-aarch64-apple-darwin-install_only.tar.gz",
              "sha256": "e956e60bc9465d577ef8062059aa05cd3a2665b4b8678a2ed24e432368330b8f",
              "size": 25371130
            }
          ],
          "bin": "python/bin/python3"
        },
        "darwin-x64": {
          "kind": "archive",
          "files": [
            {
              "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20261110/cpython-3.12.16%2B20261110-x86_64-apple-darwin-install_only.tar.gz",
              "sha256": "83f2922437e6d546d0fcdb8c11f150a8e52787e8d9ea8651b1974e20908eb1bc",
              "size": 25078514
            }
          ],
          "bin": "python/bin/python3"
        },
        "win32-x64": {
          "kind": "archive",
          "files": [
            {
              "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20261110/cpython-3.12.16%2B20261110-x86_64-pc-windows-msvc-install_only.tar.gz",
              "sha256": "e23fe5b16926de1d81661b1a97352e89fb167549c55a6825796ccd0f32ec7f1b",
              "size": 47438699
            }
          ],
          "bin": "python/python.exe"
        }
      },
      "probe": { "steps": [{ "run": ["{bin}", "-I", "-c", "import sys, ssl, sqlite3; print('Python', sys.version.split()[0])"], "expect": "^Python 3\\.12\\.16" }] }
    },
    {
      "name": "venv",
      "version": "3.12.16",
      "licence": "PSF-2.0",
      "licenceNote": "A virtual environment of the python tool, with the pip it bundles (MIT). Pillars add packages to it with a pip tool of their own; an AGPL package (PyMuPDF) runs only as a separate, unmodified Python process.",
      "homepage": "https://docs.python.org/3/library/venv.html",
      "needs": ["python"],
      "platforms": {
        "linux-x64": { "kind": "venv", "bin": "bin/python" },
        "darwin-arm64": { "kind": "venv", "bin": "bin/python" },
        "darwin-x64": { "kind": "venv", "bin": "bin/python" },
        "win32-x64": { "kind": "venv", "bin": "Scripts/python.exe" }
      },
      "probe": { "steps": [{ "run": ["{bin}", "-I", "-c", "import sys, pip; print('venv', sys.prefix != sys.base_prefix, 'pip', pip.__version__)"], "expect": "^venv True pip " }] }
    },
    {
      "name": "ffmpeg",
      "version": "9.0.2",
