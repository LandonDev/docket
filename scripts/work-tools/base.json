      "licence": "MIT OR Apache-2.0",
      "licenceNote": "The IronCalc engine's native Node binding (@ironcalc/nodejs and its platform package), unmodified; permissive, so the host may load it in process.",
      "homepage": "https://www.ironcalc.com/",
      "platforms": {
        "linux-x64": {
          "kind": "npm",
          "files": [
            { "url": "https://registry.npmjs.org/@ironcalc/nodejs/-/nodejs-0.9.1.tgz", "integrity": "sha512-9CHeAJ7VouOXshFpvuVFyDkqUDVoWlly7jmvtgAuGQHVkLHE0d4uOjEdfds68fAqQIbwnU+lx54ECsmPoOAFHA==", "into": "node_modules/@ironcalc/nodejs" },
            { "url": "https://registry.npmjs.org/@ironcalc/nodejs-linux-x64-gnu/-/nodejs-linux-x64-gnu-0.9.1.tgz", "integrity": "sha512-BItJP0XnOWLmxc1+pSJnUvRelyGltCbVoAblEgE9/+3OY3H/s/8sNqZlhoAFCrT5D1FiZ4+gv/mwF2HBGYI+6A==", "into": "node_modules/@ironcalc/nodejs-linux-x64-gnu" }
          ],
          "bin": "node_modules/@ironcalc/nodejs"
        },
        "darwin-arm64": {
          "kind": "npm",
          "files": [
            { "url": "https://registry.npmjs.org/@ironcalc/nodejs/-/nodejs-0.9.1.tgz", "integrity": "sha512-9CHeAJ7VouOXshFpvuVFyDkqUDVoWlly7jmvtgAuGQHVkLHE0d4uOjEdfds68fAqQIbwnU+lx54ECsmPoOAFHA==", "into": "node_modules/@ironcalc/nodejs" },
            { "url": "https://registry.npmjs.org/@ironcalc/nodejs-darwin-arm64/-/nodejs-darwin-arm64-0.9.1.tgz", "integrity": "sha512-Ht3n/C5l3hYZTJmqHIMt9zoSeyUOhkc4uUEg2xbQvtSdO2SOzK9BrmW7W2ZoU7rhywn2LNPQY3bA/QxJLOCiwA==", "into": "node_modules/@ironcalc/nodejs-darwin-arm64" }
          ],
          "bin": "node_modules/@ironcalc/nodejs"
        },
        "darwin-x64": {
          "kind": "npm",
          "files": [
            { "url": "https://registry.npmjs.org/@ironcalc/nodejs/-/nodejs-0.9.1.tgz", "integrity": "sha512-9CHeAJ7VouOXshFpvuVFyDkqUDVoWlly7jmvtgAuGQHVkLHE0d4uOjEdfds68fAqQIbwnU+lx54ECsmPoOAFHA==", "into": "node_modules/@ironcalc/nodejs" },
            { "url": "https://registry.npmjs.org/@ironcalc/nodejs-darwin-x64/-/nodejs-darwin-x64-0.9.1.tgz", "integrity": "sha512-/oTkx5L9smC6gnkOXxaJowhHO4J83YEwKvIzUHPOSPJzi8GKym8c3CyFZB2BO61JfZWQE3IfO355Tuo4PbeCHQ==", "into": "node_modules/@ironcalc/nodejs-darwin-x64" }
          ],
          "bin": "node_modules/@ironcalc/nodejs"
