            { "url": "https://registry.npmjs.org/@ironcalc/nodejs-win32-x64-msvc/-/nodejs-win32-x64-msvc-0.9.1.tgz", "integrity": "sha512-gNxwtec10cW4+kZzsM/fX3ZS3SKAoECWd7FRsU4WfZYqExWjx5JOjpu9uyB67RLrlraxO7rR6mkBSAQ/ffPfGA==", "into": "node_modules/@ironcalc/nodejs-win32-x64-msvc" }
          ],
          "bin": "node_modules/@ironcalc/nodejs"
        }
      },
      "probe": {
        "steps": [
          {
            "run": ["{node}", "-e", "const { Model } = require(process.env.IRONCALC); const m = new Model('probe', 'en', 'UTC'); m.setUserInput(0, 1, 1, '=SUM(2,3)*7'); m.evaluate(); console.log('ironcalc', m.getFormattedCellValue(0, 1, 1))"],
            "env": { "IRONCALC": "{bin}" },
            "expect": "^ironcalc 35"
          }
        ]
      }
    }
  ]
}
