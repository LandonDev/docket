          {
            "run": [
              "{bin:xorg}",
              "-version"
            ],
            "env": {
              "LD_LIBRARY_PATH": "{dir}/sys/usr/lib/x86_64-linux-gnu"
            },
            "expect": "X\\.Org X Server"
          },
          {
            "run": [
              "{bin:xclip}",
              "-version"
            ],
            "env": {
              "LD_LIBRARY_PATH": "{dir}/sys/usr/lib/x86_64-linux-gnu"
            },
            "expect": "xclip version"
          }
